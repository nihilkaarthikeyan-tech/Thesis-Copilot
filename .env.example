# Thesis Copilot environment — every variable in PRD §13.3, validated by packages/config at boot.
# The app refuses to start if a required variable is missing (PRD §0.2).
#
# Copy to .env and fill in. Comments are on their own lines, never trailing a value, so that every
# parser reads the value exactly as written.

# ============================== Core ==============================

# development | test | production
NODE_ENV=development

# Public URL of the web app. Must be https in production (PRD §12.1).
APP_URL=http://localhost:3000

# Public URL of the API, used by the web app for fetches and the SSE stream.
API_URL=http://localhost:3001

# Same value, exposed to the browser bundle by Next.js (NEXT_PUBLIC_ prefix is required for that).
NEXT_PUBLIC_API_URL=http://localhost:3001

# ========================== Data stores ===========================

# PostgreSQL 16 + pgvector. The dev Compose file maps it to 5434.
DATABASE_URL=postgresql://tc:tc@localhost:5434/tc

# Redis 7, used for BullMQ queues, rate limits and the flag cache. Dev Compose maps 6381.
REDIS_URL=redis://localhost:6381

# ===================== Object storage (MinIO) =====================

# S3 API endpoint. Dev Compose maps 9002 (the console is on 9003).
S3_ENDPOINT=http://localhost:9002

# MinIO root user in dev. At least 3 characters.
S3_ACCESS_KEY=tcadmin

# MinIO root password in dev. At least 8 characters.
S3_SECRET_KEY=tc-secret-key

# Bucket holding PDFs, exports and chapter snapshots.
S3_BUCKET=thesis-copilot

# Any value; MinIO ignores the region.
S3_REGION=us-east-1

# ======================= Auth (Better Auth) =======================

# Session signing secret. At least 32 characters. Generate a fresh one per environment.
AUTH_SECRET=change-me-to-a-32-character-random-string

# Google OAuth. Optional, but both must be set together or both left empty.
# Email OTP works without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ========================== LLM provider ==========================

# anthropic | mock. The mock provider replays fixtures and is what tests use.
AI_PROVIDER=anthropic

# Required when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# ADR-0011: needed only when AI_FAST_MODEL or AI_STRONG_MODEL names an OpenAI model
# (gpt-*, o1/o3/o4). The vendor is derived from the model id; there is no provider variable.
OPENAI_API_KEY=

# Mock provider only: simulated time-to-first-token in ms (PRD §16 week 1 uses 250).
AI_MOCK_LATENCY_MS=250

# Model ids are NEVER guessed (PRD §0.3 rule 5). Leave blank until `pnpm ai:verify` confirms
# them against the provider, then paste the verified ids here and into PRD Appendix E.3.
AI_FAST_MODEL=
AI_STRONG_MODEL=
# ADR-0074: the tier that writes chat answers, `strong` (default) or `fast`.
AI_CHAT_TIER=strong

# =========================== Embeddings ===========================

# voyage | mock
EMBED_PROVIDER=voyage

# Required when EMBED_PROVIDER=voyage.
VOYAGE_API_KEY=

# Embedding model id — `voyage-4` (ADR-0032). Verified by `pnpm ai:verify`, same rule as the
# LLM ids. Changing it means `pnpm ai:reembed`, or every stored vector is silently wrong.
AI_EMBED_MODEL=voyage-4

# Vector dimension. Must match vector(N) in packages/db/prisma/schema.prisma.
EMBED_DIMS=1024

# Optional. The whole site's AI spend for a calendar month, in rupees; every AI call is refused
# once it is reached, until the 1st. The per-student ₹100 ceiling applies regardless.
PLATFORM_MONTHLY_CEILING_INR=
# Sign-in attempts a minute per IP. Leave blank in production (PRD §12.1: twenty). Only a test
# environment raises it; CI sets 600 so seventy browser tests can each mint an account.
AUTH_RATE_LIMIT_PER_MINUTE=
# Optional. Extra addresses for the §14 alert emails (cost thresholds, the site-wide budget,
# job failures), comma-separated. The SEED_ADMIN_EMAIL address always receives them.
ALERT_EMAILS=

# ========================= Scholarly APIs =========================

# Contact emails for the polite pools. Use a real address you monitor.
OPENALEX_MAILTO=you@example.com
# Free from openalex.org (account settings). Without it the whole site gets about a hundred
# OpenAlex searches a day; with it, about a thousand. Optional, but set it in production.
OPENALEX_API_KEY=
CROSSREF_MAILTO=you@example.com
UNPAYWALL_EMAIL=you@example.com

# Optional.
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
# Optional (ADR-0134). Free "Open Access" key from https://dev.springernature.com: full text of
# Springer, Nature, BMC and SpringerOpen open-access papers (500 requests a day on the free plan).
SPRINGER_NATURE_API_KEY=
# Optional (ADR-0020). PubMed search works without it at NCBI's 3 requests/second; a free key
# from an NCBI account raises that to 10.
NCBI_API_KEY=

# ==================== Payments (Razorpay, P2) =====================

# Billing ships in Phase 2 week 11. Leave all three empty until then; set all three together.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_ANNUAL=
RAZORPAY_WEBHOOK_SECRET=

# ============================== Email =============================

# Resend, or the SMTP_* block below. One of the two is required in production so email OTP can be
# delivered; in development the OTP is logged to the console instead.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Sender for either transport, e.g. "Thesis Copilot <no-reply@your-domain>". Resend only sends
# from a domain verified in its dashboard. Falls back to SMTP_FROM, then no-reply@<APP_URL host>.
MAIL_FROM=

# ======================= Document services ========================

# Gotenberg, used for PDF export. Dev Compose maps 3002.
GOTENBERG_URL=http://localhost:3002

# Optional. GROBID sits behind the `grobid` feature flag (PRD FR-1.7).
GROBID_URL=

# ==================== Overrides / observability ===================

# Optional JSON that hot-overrides packages/config/pricing.ts, e.g. {"inrPerUsd": 90}
PRICING_OVERRIDE_JSON=

# ADR-0028: serve the live co-authoring WebSocket from this API process. In development the one
# API does; in production only the `collab` service sets it (compose does), never the `api`
# replicas. The `collaboration` feature flag must be on as well.
COLLAB_ENABLED=true

# Optional.
SENTRY_DSN=

# =============================== Seed =============================

# The SUPERADMIN account created by `pnpm db:seed`.
SEED_ADMIN_EMAIL=admin@example.com
