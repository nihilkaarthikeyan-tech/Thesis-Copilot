# ---- Core (PRD §13.3) ----
NODE_ENV=development                      # development | test | production
APP_URL=http://localhost:3000             # public URL of the web app
API_URL=http://localhost:3001             # public URL of the API (used by web for SSE and fetches)

# ---- Data stores ----
DATABASE_URL=postgresql://tc:tc@localhost:5434/tc   # Postgres 16 + pgvector (dev Compose maps 5434)
REDIS_URL=redis://localhost:6381                    # Redis 7 (dev Compose maps 6381)

# ---- Object storage (MinIO, S3 API) ----
S3_ENDPOINT=http://localhost:9002         # MinIO API endpoint (dev Compose maps 9002; console 9003)
S3_ACCESS_KEY=tc                          # MinIO root user in dev
S3_SECRET_KEY=tc-secret-key               # MinIO root password in dev (>= 8 chars)
S3_BUCKET=thesis-copilot                  # bucket for PDFs, exports, snapshots
S3_REGION=us-east-1                       # any value; MinIO ignores region

# ---- Auth (Better Auth) ----
AUTH_SECRET=change-me-to-a-32-char-random-string   # session signing secret; >= 32 chars
GOOGLE_CLIENT_ID=                         # Google OAuth client id (may be empty until Google login is enabled)
GOOGLE_CLIENT_SECRET=                     # Google OAuth client secret

# ---- LLM provider (PRD §10.1; ids verified by `pnpm ai:verify`, Appendix E) ----
AI_PROVIDER=anthropic                     # anthropic | mock
ANTHROPIC_API_KEY=                        # required when AI_PROVIDER=anthropic
AI_FAST_MODEL=                            # fast-tier model id (fill after `pnpm ai:verify`; never guessed)
AI_STRONG_MODEL=                          # strong-tier model id (fill after `pnpm ai:verify`)

# ---- Embeddings ----
EMBED_PROVIDER=voyage                     # voyage | mock
VOYAGE_API_KEY=                           # required when EMBED_PROVIDER=voyage
AI_EMBED_MODEL=                           # embedding model id (fill after `pnpm ai:verify`)
EMBED_DIMS=1024                           # vector dimension; must match schema.prisma vector(1024)

# ---- Scholarly APIs (polite-pool contact emails) ----
OPENALEX_MAILTO=you@example.com           # OpenAlex polite pool
CROSSREF_MAILTO=you@example.com           # Crossref polite pool
UNPAYWALL_EMAIL=you@example.com           # Unpaywall requires an email
SEMANTIC_SCHOLAR_API_KEY=                 # optional
CORE_API_KEY=                             # optional (CORE full-text fallback)

# ---- Payments (Razorpay; Phase 2) ----
RAZORPAY_KEY_ID=                          # optional until billing ships
RAZORPAY_KEY_SECRET=                      # optional until billing ships
RAZORPAY_WEBHOOK_SECRET=                  # optional until billing ships

# ---- Email (Resend or SMTP; one of the two is required) ----
RESEND_API_KEY=                           # Resend API key (transactional email)
SMTP_HOST=                                # SMTP alternative to Resend
SMTP_PORT=                                # e.g. 587
SMTP_USER=                                # SMTP username
SMTP_PASS=                                # SMTP password
SMTP_FROM=                                # From address, e.g. "Thesis Copilot <no-reply@example.com>"

# ---- Document services ----
GOTENBERG_URL=http://localhost:3002       # Gotenberg (PDF export); dev Compose maps 3002
GROBID_URL=                               # optional; GROBID behind feature flag `grobid`

# ---- Overrides / observability ----
PRICING_OVERRIDE_JSON=                    # optional JSON hot-override of packages/config/pricing.ts
SENTRY_DSN=                               # optional

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@example.com        # SUPERADMIN user created by `pnpm db:seed` (PHASES 0.4)
