# Production environment for infra/compose/docker-compose.prod.yml — PRD §13.2, §13.3.
#
# On the VPS: copy this file to infra/compose/.env and fill it in. Every service reads it through
# `env_file: .env`, and `deploy.sh` rewrites the TAG line on each release. Comments stay on their
# own lines, never trailing a value.
#
# The same variables as the root .env.example, with the values a Compose network needs: services
# reach each other by service name (postgres, redis, minio, gotenberg), never by localhost.

# ====================== Compose / release ======================

# The public hostname the host's nginx serves and holds a certificate for (ADR-0012).
DOMAIN=app.example.com

# GitHub org or user whose GHCR holds tc-web / tc-api / tc-backup.
GHCR_ORG=your-github-org

# Image tag to run. deploy.sh sets this; leave the initial value at the first release tag.
TAG=v0.1.0

# ============================== Core ==============================

NODE_ENV=production

# Must be https in production (PRD §12.1). Web and API share the domain; `edge.conf` routes
# /api/* to the API and the rest to the web app.
APP_URL=https://app.example.com
API_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://app.example.com

# ========================== Data stores ===========================

# The postgres service. Set POSTGRES_PASSWORD once and never change it without a dump/restore.
POSTGRES_USER=tc
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=tc
DATABASE_URL=postgresql://tc:change-me-long-random@postgres:5432/tc

# The redis service.
REDIS_URL=redis://redis:6379

# ===================== Object storage (MinIO) =====================

# The minio service; the same two values become MinIO's root credentials.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key-at-least-8
S3_BUCKET=thesis-copilot
S3_REGION=us-east-1

# =========================== Backups ==============================

# Off-site copy of the nightly dump and the object store (PRD §12.1). Without these the backup
# service keeps dumps on the VPS only, which is not a backup.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
# Days of local dumps to keep. Optional; backup.sh defaults to 14.
BACKUP_KEEP_DAYS=14

# ======================= Auth (Better Auth) =======================

# At least 32 characters; generate fresh for this environment.
AUTH_SECRET=change-me-to-a-32-character-random-string

# Optional; both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ========================== LLM provider ==========================

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required whenever AI_FAST_MODEL or AI_STRONG_MODEL names an OpenAI model (ADR-0011). Missing
# from this file until 2026-09-19 -- the app refuses to start without it once a gpt-* id is
# configured, and this template had no line for it at all.
OPENAI_API_KEY=

# Never guessed (PRD §0.3 rule 5): paste the ids `pnpm ai:verify` confirmed.
AI_FAST_MODEL=
AI_STRONG_MODEL=

# =========================== Embeddings ===========================

EMBED_PROVIDER=voyage
VOYAGE_API_KEY=
AI_EMBED_MODEL=
EMBED_DIMS=1024

# ========================= Scholarly APIs =========================

# A real address you monitor (polite pools; Unpaywall refuses example.com with HTTP 422).
OPENALEX_MAILTO=you@your-domain
CROSSREF_MAILTO=you@your-domain
UNPAYWALL_EMAIL=you@your-domain

# Optional. CORE is the full-text fallback after Unpaywall (FR-2.2).
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=

# ==================== Payments (Razorpay) =========================

# All three keys together, plus the two plan ids created in the Razorpay dashboard (§11.6).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_ANNUAL=

# ============================== Email =============================

# Required in production: Resend, or the SMTP block. The sign-in code goes out this way.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Sender for either transport. With Resend the domain must be verified in its dashboard first.
MAIL_FROM=Thesis Copilot <no-reply@app.example.com>

# ======================= Document services ========================

# The gotenberg service.
GOTENBERG_URL=http://gotenberg:3000

# Optional; only read when the `grobid` profile and feature flag are on.
GROBID_URL=

# ==================== Overrides / observability ===================

PRICING_OVERRIDE_JSON=
SENTRY_DSN=

# =============================== Seed =============================

# The SUPERADMIN account `pnpm db:seed` creates; §14 alert emails go here.
SEED_ADMIN_EMAIL=admin@your-domain
