# Copy to infra/compose/.env on the VPS. Everything in the root .env.example applies too (the
# compose file passes .env to every service); these are the deploy-only variables.
DOMAIN=app.example.com
GHCR_ORG=your-github-org
TAG=v0.1.0
POSTGRES_USER=tc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tc
# Inside the stack the hostnames are the service names:
DATABASE_URL=postgresql://tc:change-me@postgres:5432/tc
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
GOTENBERG_URL=http://gotenberg:3000
# Off-site mirror for backups (PRD §12.1): any S3-compatible bucket.
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=thesis-copilot-backups
