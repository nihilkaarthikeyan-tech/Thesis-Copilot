# Reverse proxy — PRD §13.2, automatic TLS (PRD §7.2), HSTS (PRD §12.1).
#
# `flush_interval -1` on /api/* disables response buffering so Server-Sent Events reach the
# browser token by token (PRD Appendix B.8). Without it Caddy would batch the ghost-text stream
# and TTFB would be the whole response.

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	handle /api/* {
		reverse_proxy api:3001 {
			flush_interval -1
			transport http {
				read_timeout 10m
			}
		}
	}

	handle /metrics {
		# Prometheus scrape path is internal only (PRD §13.1).
		respond 404
	}

	handle {
		reverse_proxy web:3000
	}
}
