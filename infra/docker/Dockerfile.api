# API + worker image — PRD §13.4: multi-stage, pnpm fetch, Turborepo --filter, node:22-alpine,
# non-root, tini as PID 1. One image, two commands (api / worker) chosen by Compose.
#
#   docker build -f infra/docker/Dockerfile.api -t tc-api .
#
# The runtime stage copies the builder's node_modules wholesale rather than doing a pruned
# --prod install. That keeps the Prisma CLI and generated client in the image, which
# `release.yml` needs to run `prisma migrate deploy` in a one-off container (PRD §13.5).
# Trimming the image is a later optimisation, not a Phase 0 concern (PRD §0.3 rule 6).

ARG NODE_IMAGE=node:22-alpine

# ---------------------------------------------------------------- deps
FROM ${NODE_IMAGE} AS deps
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN pnpm fetch

# ---------------------------------------------------------------- build
FROM deps AS build
COPY . .
RUN pnpm install --offline --frozen-lockfile
RUN pnpm --filter @tc/db exec prisma generate
RUN pnpm turbo run build --filter=@tc/api --filter=@tc/worker

# ---------------------------------------------------------------- runtime
FROM ${NODE_IMAGE} AS runtime
RUN apk add --no-cache tini wget \
 && addgroup -S app && adduser -S -G app -u 1001 app
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=app:app /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=build --chown=app:app /app/node_modules ./node_modules
COPY --from=build --chown=app:app /app/packages ./packages
COPY --from=build --chown=app:app /app/apps/api/package.json ./apps/api/package.json
COPY --from=build --chown=app:app /app/apps/api/dist ./apps/api/dist
COPY --from=build --chown=app:app /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build --chown=app:app /app/apps/worker/package.json ./apps/worker/package.json
COPY --from=build --chown=app:app /app/apps/worker/dist ./apps/worker/dist
COPY --from=build --chown=app:app /app/apps/worker/node_modules ./apps/worker/node_modules
USER app
EXPOSE 3001
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/api/dist/main.js"]
