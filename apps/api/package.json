    "ioredis": "5.11.1",
    "lib0": "0.2.117",
    "minio": "8.0.7",
    "nestjs-pino": "4.6.1",
    "parse5": "8.0.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
