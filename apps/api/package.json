{
  "name": "@tc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- node --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "pilot:report": "dotenv -e ../../.env -- tsx scripts/pilot-report.ts",
    "backfill:journals": "dotenv -e ../../.env -- tsx scripts/backfill-journal-citedness.ts",
    "reembed": "dotenv -e ../../.env -- tsx scripts/reembed-chunks.ts",
    "prune-chunks": "dotenv -e ../../.env -- tsx scripts/prune-chunks.ts",
    "research:thresholds": "dotenv -e ../../.env -- tsx scripts/chat-research-thresholds.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:local": "dotenv -e ../../.env -- node dist/main.js",
    "privacy:notice": "dotenv -e ../../.env -- node dist/privacy-notice.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
