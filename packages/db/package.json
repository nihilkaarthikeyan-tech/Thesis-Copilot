{
  "name": "@tc/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "migrate:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "prisma": "dotenv -e ../../.env -- prisma",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tc/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "dotenv-cli": "11.0.0",
    "prisma": "6.19.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "prisma"
  ]
}
