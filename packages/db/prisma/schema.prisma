// Thesis Copilot data model.
//
// Copied from PRD §8 ("Data model (Prisma)"), which is canonical. The only edits are syntactic:
// the PRD compresses `generator`, `datasource` and the `enum` blocks onto single lines with
// semicolons to save space, which Prisma cannot parse. Field names, types, attributes, defaults,
// relations, indexes and comments are unchanged. Any real change needs an ADR (PRD §0.3 rule 4).
//
// Vector columns use `Unsupported("vector(1024)")`; the HNSW indexes are created in the
// hand-written migration `migrations/0001_init/migration.sql`.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // "native" for local dev; linux-musl for the node:22-alpine runtime image (PRD §13.4).
  // Generator config only — the data model below is PRD §8 verbatim.
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  STUDENT
  GUIDE
  INSTITUTION_ADMIN
  SUPERADMIN
}
enum Plan {
  FREE_TRIAL
  STUDENT_MONTHLY
  STUDENT_ANNUAL
  INSTITUTION_SEAT
}
enum EntryPath {
  A_TOPIC
  B_PAPER
}
enum Template {
  STEM_EMPIRICAL
  QUALITATIVE
  COMPILATION
}
enum SourceStatus {
  PENDING
  RESOLVED
  UNRESOLVED
  FAILED
}
enum GroundingLevel {
  NONE
  ABSTRACT
  FULL_TEXT
}
enum Provenance {
  HUMAN
  ASSIST
  DRAFT
  COMMAND
  HUMAN_EDITED
}
enum AiAction {
  ASSIST
  DRAFT
  CITE
  CHAT
  COMMAND
  EXTRACT
  OUTLINE
  STYLE_PROFILE
  SEARCH_QUERIES
  COHERENCE
  CLASSIFY_COMMENT
  SCOPED_REVISION
  PARSE_CITATION
  EMBED
  PROPOSAL      // ADR-0005: Path A conversation (A.6)
  CROSS_PAPER   // ADR-0005: multi-paper consistency pass (A.16)
  VIVA          // ADR-0030: viva preparation — a question set, or feedback on one answer
}
enum FlagType {
  TERM_DRIFT
  CLAIM_CONTRADICTION
  UNSUPPORTED_CLAIM
  CITATION_INTEGRITY
  OUTLINE_DRIFT
  CITATION_SUPPORT // ADR-0023: whether the cited passage supports what the sentence says
}
enum Severity {
  INFO
  WARN
  ERROR
}
enum CommentClass {
  SUBSTANTIVE
  CLARIFICATION
  MECHANICAL
}
enum CommentStatus {
  OPEN
  ACCEPTED
  EDITED
  REJECTED
}

model User {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email         String   @unique
  name          String?
  role          Role     @default(STUDENT)
  plan          Plan     @default(FREE_TRIAL)
  institutionId String?  @db.Uuid
  institution   Institution? @relation(fields: [institutionId], references: [id])
  timezone      String   @default("Asia/Kolkata")
  settings      Json?    // ADR-0006: per-user preferences (FR-4.6 automaticSuggest, chat filters)
  createdAt     DateTime @default(now())
  // --- Better Auth additions (ADR-0002); everything above this line is PRD §8 verbatim ---
  emailVerified Boolean  @default(false)
  image         String?
  updatedAt     DateTime @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  // --- end Better Auth additions ---
  documents     Document[]
  usage         UsageLedger[]
  aiCalls       AiCallLog[]
  subscription  Subscription?
  guideShares   GuideShare[]
  savedPrompts  SavedPrompt[]
  // --- PRD §12.2 account deletion ---
  /**
   * When the student asked for their account to be erased, or null if they have not.
   *
   * A request, not the erasure: §12.2 allows 30 days, and the days are the point. They are what
   * lets a student who clicked in anger, or whose mailbox was borrowed for an evening, undo it —
   * and with OTP sign-in a borrowed mailbox is the whole threat model. `DeletionScheduler` does
   * the erasing once the grace period is up.
   */
  deletionRequestedAt DateTime?
  /**
   * When the erasure actually ran. Set on a row that has been stripped of everything it is legal
   * to strip: content gone, email replaced, the row kept only so the billing records §12.2
   * requires us to retain still have something to point at.
   */
  deletedAt           DateTime?
  @@index([deletionRequestedAt])
}

model Institution {
  id        String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name      String
  seats     Int    @default(0)
  templateId String? @db.Uuid
  users     User[]
  createdAt DateTime @default(now())
  // --- ADR-0009: FR-9.6 needs a rate and an address to invoice against ---
  /** The negotiated per-seat rate for a period (PRD 11.6: "200-250 negotiated"). */
  seatPriceInr Int @default(0)
  /** monthly | yearly - what one seat charge buys. */
  billingPeriod String @default("yearly")
  /** Where the invoice goes; the admin's own address when it is not set. */
  billingEmail String?
  invites   InstitutionInvite[]
}

/**
 * A seat held for a named address before that person has an account - ADR-0009.
 *
 * Seats have to be counted before anyone signs up, or an institution with 30 seats can invite 300
 * people and only discover the overcount when the 31st arrives. A pending invite holds a seat; it
 * is released when the invite is revoked or it expires.
 */
model InstitutionInvite {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  institutionId String   @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  email         String
  invitedById   String   @db.Uuid
  acceptedAt    DateTime?
  acceptedById  String?  @db.Uuid
  revokedAt     DateTime?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  @@unique([institutionId, email])
  @@index([email])
}

model Document {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ownerId     String    @db.Uuid
  owner       User      @relation(fields: [ownerId], references: [id])
  title       String
  entryPath   EntryPath
  template    Template?
  field       String?
  language    String    @default("en")
  citationStyle String  @default("apa")
  /**
   * The date the thesis is due, if the student has told us.
   *
   * A date, not a timestamp: a submission deadline is a day in the student's own calendar, and
   * storing an instant would make "due today" depend on a timezone the university does not use.
   * Optional because most students do not know it when they start, and nothing may require it.
   */
  submissionDeadline DateTime? @db.Date
  institutionTemplateId String? @db.Uuid
  meta        Json?     // PRD §9.1/§15: { proposalChat?: Message[], thesisDetails?: {...} }
  memory      DocumentMemory?
  chapters    Chapter[]
  sources     Source[]
  seedPapers  SeedPaper[]
  flags       CoherenceFlag[]
  vivaQuestions VivaQuestion[]
  comments    Comment[]
  shares      GuideShare[]
  versions    DocumentVersion[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([ownerId])
}

model DocumentMemory {
  documentId   String  @id @db.Uuid
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  scope        Json     // { workingTitle, problemStatement, objectives[], whyOpen }
  outline      Json     // OutlineNode[] (schema §10.7.2)
  glossary     Json     // { term: { definition, usageNote, sourceChapterId? } }
  styleProfile Json?    // { avgSentenceLen, register, voice, transitions[], sample[] }
  gapMap       Json?    // { themes: [{ name, count, thin, sourceIds[] }] }
  updatedAt    DateTime @updatedAt
}

model SeedPaper {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  documentId  String   @db.Uuid
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileKey     String   // MinIO key
  filename    String
  extraction  Json?    // PaperExtraction (§10.7.1)
  status      String   @default("PENDING")
  error       String?
  createdAt   DateTime @default(now())
}

model Chapter {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  documentId    String   @db.Uuid
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  outlineNodeId String   // matches DocumentMemory.outline node id
  title         String
  order         Int
  content       Json     // ProseMirror doc JSON
  wordCount     Int      @default(0)
  scopeNote     String?
  lastCheckedAt DateTime?
  // --- ADR-0003 additions (Appendix B.7 optimistic concurrency, B.4 word counts) ---
  version       Int      @default(1)
  wordCounts    Json?    // { HUMAN, ASSIST, DRAFT, COMMAND, HUMAN_EDITED } word counts, computed on save
  snapshotAt    DateTime? // last DocumentVersion snapshot for this chapter (B.7: >= 10 min rule)
  // --- end ADR-0003 ---
  pins          ChapterSourcePin[]
  chunks        ChapterChunk[]
  citations     Citation[]
  updatedAt     DateTime @updatedAt
  @@unique([documentId, outlineNodeId])
  @@index([documentId, order])
}

model ChapterSourcePin {
  chapterId String @db.Uuid
  sourceId  String @db.Uuid
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  source    Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  @@id([chapterId, sourceId])
}

model Source {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  documentId     String   @db.Uuid
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status         SourceStatus @default(PENDING)
  rawReference   String?
  doi            String?
  openalexId     String?
  title          String?
  authors        Json?    // [{ family, given }]
  year           Int?
  venue          String?
  type           String?  // journal-article, book, etc. (CSL type)
  cslJson        Json?    // full CSL-JSON for citeproc
  oaStatus       String?
  fileKey        String?  // MinIO key of PDF if available
  groundingLevel GroundingLevel @default(NONE)
  subTheme       String?
  citationCount  Int?
  isPreprint     Boolean  @default(false)
  isRetracted    Boolean  @default(false)
  // --- ADR-0022: the journal's 2-year mean citedness, OpenAlex's impact-factor-style figure ---
  venueOpenalexId String?  // OpenAlex source id, `S…`
  venueCitedness  Float?   // null when OpenAlex has no figure for the journal, or none was looked up
  pins           ChapterSourcePin[]
  chunks         SourceChunk[]
  citations      Citation[]
  createdAt      DateTime @default(now())
  @@index([documentId])
  @@index([doi])
}

model SourceChunk {
  id        String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  sourceId  String  @db.Uuid
  source    Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ordinal   Int
  page      Int?
  charStart Int?
  charEnd   Int?
  section   String?
  text      String
  tokenCount Int
  embedding Unsupported("vector(1024)")?
  @@index([sourceId, ordinal])
}

model ChapterChunk {
  id        String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  chapterId String  @db.Uuid
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  ordinal   Int
  from      Int     // ProseMirror positions at index time
  to        Int
  text      String
  embedding Unsupported("vector(1024)")?
  @@index([chapterId, ordinal])
}

model Citation {
  id        String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  chapterId String  @db.Uuid
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sourceId  String  @db.Uuid
  source    Source  @relation(fields: [sourceId], references: [id])
  chunkId   String? @db.Uuid
  nodeKey   String  // stable key stored on the ProseMirror citation node
  role      String  @default("parenthetical")
  locator   String?
  createdAt DateTime @default(now())
  @@unique([chapterId, nodeKey])
}

model SearchCandidate {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  runId         String   @db.Uuid
  documentId    String   @db.Uuid
  openalexId    String?
  doi           String?
  title         String
  abstract      String?
  year          Int?
  venue         String?
  citationCount Int?
  isPreprint    Boolean  @default(false)
  oaStatus      String?
  theme         String?
  score         Float?
  selected      Boolean  @default(false)
  createdAt     DateTime @default(now())
  @@index([documentId, runId])
}

model DocumentVersion {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chapterId  String?  @db.Uuid
  snapshotKey String  // MinIO key (gzipped JSON)
  reason     String   // AUTOSAVE | MANUAL | PRE_DRAFT_ACCEPT | PRE_REVISION | PRE_RESTORE
  /// Words in the chapter at this version; null for versions written before it was recorded.
  wordCount  Int?
  createdAt  DateTime @default(now())
  @@index([documentId, createdAt])
}

model SuggestionEvent {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId      String   @db.Uuid
  documentId  String   @db.Uuid
  chapterId   String?  @db.Uuid
  action      AiAction
  shownChars  Int
  keptChars   Int      @default(0)
  outcome     String   // SHOWN | ACCEPTED | PARTIAL | EDITED | REJECTED | CANCELLED | DISCARDED
  latencyMs   Int
  ttfbMs      Int?
  guided      Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
  @@index([documentId, createdAt])
}

model AiCallLog {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id])
  documentId        String?  @db.Uuid
  action            AiAction
  model             String
  inputTokens       Int
  cachedInputTokens Int      @default(0)
  cacheWriteTokens  Int      @default(0)
  outputTokens      Int
  costMicroInr      BigInt
  latencyMs         Int
  ok                Boolean  @default(true)
  error             String?
  createdAt         DateTime @default(now())
  @@index([userId, createdAt])
}

/**
 * ADR-0004. Things that happened to a user that no other table records: a cap refusal, an admin
 * resetting caps or changing a plan, a feedback message. `kind` is a string, not an enum, so a
 * new kind is a code change rather than a migration.
 */
model AuditEvent {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  kind       String   // CAP_EXCEEDED | CAPS_RESET | PLAN_CHANGED | FEEDBACK | BILLING_EVENT
  userId     String   @db.Uuid   // the subject
  actorId    String?  @db.Uuid   // who did it, when not the subject (an admin)
  documentId String?  @db.Uuid
  detail     Json?
  /**
   * Idempotency key for events that arrive from outside and may arrive twice — today only
   * Razorpay webhooks, as `billing:<providerEventId>`. Unique, so a duplicate is refused by the
   * database rather than by a read that another request can race. Null for everything else.
   */
  dedupeKey  String?  @unique
  createdAt  DateTime @default(now())
  @@index([kind, createdAt])
  @@index([userId, createdAt])
}

/**
 * ADR-0019: a question the student asks often, kept to reuse in chat by typing `/`.
 *
 * The student's own words, sent through chat exactly as if typed — not a system prompt, and it
 * changes nothing about grounding or metering. Per user rather than per thesis, because the
 * questions a student reuses ("what are the limitations of this method?") travel between theses.
 */
model SavedPrompt {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@index([userId])
}

model UsageLedger {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  period    String   // "2026-09"
  action    AiAction
  count     Int      @default(0)
  @@unique([userId, period, action])
}

model Subscription {
  userId            String   @id @db.Uuid
  user              User     @relation(fields: [userId], references: [id])
  provider          String   @default("razorpay")
  providerSubId     String?
  plan              Plan
  status            String   // active | past_due | cancelled | trialing
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model GuideShare {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  guideEmail String
  guideUserId String? @db.Uuid
  guide      User?    @relation(fields: [guideUserId], references: [id])
  token      String   @unique
  /**
   * When this guide last opened the thesis, so the progress view can say what moved since.
   *
   * Bumped only when the previous visit is more than `VISIT_WINDOW_MINUTES` old: a supervisor who
   * refreshes while reading should keep seeing the same "changed since you last looked" list,
   * not watch it empty itself underneath them.
   */
  lastViewedAt DateTime?
  /**
   * ADR-0028: a co-author rather than a guide. May open a chapter in the live editor and type
   * alongside the student; still no AI actions, uploads or exports, which stay the owner's.
   */
  canEdit    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Comment {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  documentId    String   @db.Uuid
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chapterId     String?  @db.Uuid
  authorEmail   String
  anchorKey     String?  // commentAnchor mark key in ProseMirror
  quotedText    String?
  body          String
  class         CommentClass?
  status        CommentStatus @default(OPEN)
  suggestedRevision String?
  resolutionNote String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  @@index([documentId, status])
}

model CoherenceFlag {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  documentId  String   @db.Uuid
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chapterId   String   @db.Uuid
  from        Int
  to          Int
  type        FlagType
  severity    Severity
  description String
  suggestion  String?
  relatedChapterId String? @db.Uuid
  status      String   @default("OPEN") // OPEN | RESOLVED | IGNORED
  /** ADR-0007: type + chapter + normalised flagged text; what D.1.1 dedupes and suppresses on. */
  fingerprint String   @default("")
  /** Optional reason the student gave when ignoring it (D.1.3). */
  ignoreReason String?
  runId       String   @db.Uuid
  createdAt   DateTime @default(now())
  @@index([documentId, status])
  @@index([documentId, fingerprint])
}

/// ADR-0030: a question an examiner could ask about this thesis, the passage it is about, and the
/// student's typed answer with the feedback on it. Nothing here ever enters the thesis.
model VivaQuestion {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  documentId  String    @db.Uuid
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// One generation's questions share a set id; the page shows the latest set.
  setId       String    @db.Uuid
  order       Int
  kind        String
  question    String
  /// What the examiner is testing with it, for the student's preparation.
  probing     String
  chapterId   String    @db.Uuid
  /// The passage the question is about, as it read when the question was asked.
  passage     String
  from        Int
  to          Int
  answer      String?
  /// { verdict, strengths[], gaps[], thesisSays[{ quote }], followUp }
  feedback    Json?
  answeredAt  DateTime?
  createdAt   DateTime  @default(now())
  @@index([documentId, setId])
}

model InstitutionTemplate {
  id        String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name      String
  spec      Json   // §9.4
  createdAt DateTime @default(now())
}

model FeatureFlag {
  key       String  @id
  enabled   Boolean @default(false)
  rules     Json?   // { userIds?: [], institutionIds?: [], plans?: [] }
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------------------------
// Better Auth tables — NOT in PRD §8. See docs/ADR/0002-better-auth-tables.md.
//
// PRD §7.2 fixes Better Auth (email OTP + Google) as the auth layer, and Better Auth requires the
// three tables below plus `emailVerified`, `image` and `updatedAt` on `User`. §8 omits all of
// them. The shapes were taken from `getAuthTables()` in better-auth@1.7.2 for this exact config,
// not guessed (PRD §0.3 rule 1). The `User` columns §8 does define are unchanged.
// ---------------------------------------------------------------------------------------------

model Session {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model Account {
  id                    String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  // Text, not Uuid: Better Auth's `reserveVerificationValue` inserts an id it generates itself with
  // `forceAllowId: true`, bypassing `generateId: false`. See migration 0004 and ADR-0002.
  id         String   @id @default(dbgenerated("(uuid_generate_v7())::text"))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  // DB default too, matching migration 0002 and `User.updatedAt`; caught by `prisma migrate diff`.
  updatedAt  DateTime @default(now()) @updatedAt
  @@index([identifier])
}
