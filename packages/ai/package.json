{
  "name": "@tc/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "dotenv -e ../../.env -- tsx scripts/verify.ts",
    "prompts:extract": "tsx scripts/extract-prompts.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@tc/config": "workspace:*",
    "ai": "7.0.92",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "dotenv-cli": "11.0.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "prompts"
  ]
}
