{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@tc/web", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "api",
      "url": "http://localhost:3001"
    },
    {
      "name": "api-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@tc/api", "dev"],
      "port": 3001
    },
    {
      "name": "worker-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@tc/worker", "dev"],
      "port": 3099
    },
    {
      "name": "api-mock",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@tc/api",
        "exec",
        "dotenv",
        "-e",
        "../../.env",
        "--",
        "node",
        "dist/main.js"
      ],
      "port": 3001,
      "env": {
        "AI_PROVIDER": "mock",
        "EMBED_PROVIDER": "mock",
        "AUTH_RATE_LIMIT_PER_MINUTE": "600",
        "SMTP_HOST": "",
        "RESEND_API_KEY": ""
      }
    },
    {
      "name": "worker-mock",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@tc/worker", "dev"],
      "port": 3099,
      "env": {
        "AI_PROVIDER": "mock",
        "EMBED_PROVIDER": "mock",
        "AUTH_RATE_LIMIT_PER_MINUTE": "600",
        "SMTP_HOST": "",
        "RESEND_API_KEY": ""
      }
    },
    {
      "name": "api-real",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@tc/api",
        "exec",
        "dotenv",
        "-e",
        "../../.env",
        "--",
        "node",
        "dist/main.js"
      ],
      "port": 3001,
      "env": {
        "REDIS_URL": "redis://127.0.0.1:6381"
      }
    },
    {
      "name": "worker-real",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@tc/worker",
        "exec",
        "dotenv",
        "-e",
        "../../.env",
        "--",
        "node",
        "dist/main.js"
      ],
      "port": 3099,
      "env": {
        "REDIS_URL": "redis://127.0.0.1:6381"
      }
    }
  ]
}
