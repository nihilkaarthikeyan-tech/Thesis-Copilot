{
  "name": "thesis-copilot",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:migrate": "pnpm --filter @tc/db migrate",
    "db:seed": "pnpm --filter @tc/db seed",
    "ai:verify": "pnpm --filter @tc/ai verify",
    "db:check": "pnpm --filter @tc/db check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.11.3",
      "postcss": ">=8.5.18",
      "deepmerge-ts": ">=8.0.0"
    }
  }
}
